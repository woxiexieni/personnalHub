  <diagram id="pdca-loop" name="交互逻辑与PDCA闭环">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ptitle" value="时间片 / 事件卡 / 问题卡 —— 交互逻辑与 PDCA 闭环判定（实线=已闭环，红色虚线=断点）" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="in" value="输入层&#10;&#10;事件卡：乱糟糟一段话 → AI 拆卡签收&#10;时间片：做了什么的事实记录&#10;想法：原材料仓库" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="230" height="140" as="geometry" />
        </mxCell>

        <mxCell id="np" value="PLAN 立卡&#10;&#10;问题卡 = 判据 + 试法&#10;判据必填（闸1，AI 不能替你过）&#10;来源：事件卡 AI 建议立 / 手动建" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="nd" value="DO 执行&#10;&#10;试法跑在现实里（不在软件内）&#10;时间片记录「做了」、事件卡记录「反馈」" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="nc" value="CHECK 校验&#10;&#10;证据自动累计（挂卡事件卡 ×N）&#10;评估三选一：继续/换招/关卡&#10;AI 周回看 30 天找盲区" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="940" y="120" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="na" value="ACT 处置&#10;&#10;有效，继续&#10;没用，换招（新试法重开计数）&#10;问题解决了 / 放弃这张" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1250" y="120" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="fe1" value="AI 建议立卡&#10;（挂卡即关联）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="in" target="np">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe2" value="证据素材&#10;（挂卡事件卡）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;strokeColor=#82b366;exitX=0.75;exitY=0;entryX=0.3;entryY=0;" edge="1" parent="1" source="in" target="nd">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="712" y="90" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fe3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="np" target="nd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nd" target="nc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fe5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nc" target="na">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="fb1" value="换招：新试法，&#10;AttemptCount+1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#9673a6;strokeWidth=2;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="na" target="nd">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1370" y="300" />
              <mxPoint x="940" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fb2" value="反馈更新回到输入：下次 AI 拆卡带上「正在练什么」的问题清单，解读视角就不一样" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#82b366;strokeWidth=2;dashed=1;exitX=0;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="na" target="in">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1370" y="480" />
              <mxPoint x="155" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="arch" value="关卡归档&#10;&#10;结案笔记 + 模式卡沉淀（影子层，软引用）&#10;状态=已解决/放弃，进归档区" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="940" y="345" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fb3" value="关卡/放弃" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#999999;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="na" target="arch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1370" y="322" />
              <mxPoint x="1065" y="322" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fb4" value="模式 → 下次立卡参考&#10;（影子层：仅文本引用，未真关联）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="arch" target="np">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="gap1" value="⚠ 断点 1&#10;&#10;「有效，继续」不写库：只弹提示文字，没有评估时间戳、没有「N 天没评估」提醒 —— CHECK 的结果没有持久化，环看起来在转但系统不知道" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;strokeColor=#e24b4a;strokeWidth=2;fillColor=#fcebeb;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="345" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fg1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#e24b4a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nc" target="gap1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gap2" value="⚠ 断点 2&#10;&#10;模式卡与证据未真关联（v2 计划）；AI 周回看靠手动点按钮，无定时提醒" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;strokeColor=#e24b4a;strokeWidth=2;fillColor=#fcebeb;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="345" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fg2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#e24b4a;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="gap2" target="arch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="concl" value="结论：P→D→C→A 主环已通（立卡 → 试法 → 证据/评估 → 三选一处置 → 换招/关卡/反馈回输入）。两个断点：① 「有效，继续」无持久化（加 LastReviewedAt + 超期提醒即闭合）；② 模式沉淀是软引用，v2 再真关联。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eaf3de;strokeColor=#3b6d11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="1450" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
