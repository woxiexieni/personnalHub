<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalHub.Client.BlockLibraryPage"
             Title="时间块库">

    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="10">

            <!-- 顶部：哪一段 + 数据源（本地 30 天 / 服务器全部）+ 清筛选 -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="1">
                    <Label x:Name="RangeLabel" Text="全部" FontSize="15" FontAttributes="Bold"/>
                    <Label x:Name="RangeSubLabel" Text="最近 30 天 · 本地副本" FontSize="11"
                           TextColor="{StaticResource Gray500}"/>
                </VerticalStackLayout>

                <!-- 数据源：显示的是"现在在看哪里"，点一下就切过去。
                     本地只有 30 天镜像，更早的都在服务端，所以必须能切。 -->
                <Button Grid.Column="1" x:Name="SourceBtn" Text="本地 30 天"
                        FontSize="12" HeightRequest="32" Padding="10,0"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Gray500}"
                        BorderWidth="1" BorderColor="{StaticResource Gray300}"
                        Clicked="OnSourceClicked"/>

                <Button Grid.Column="2" x:Name="ClearBtn" Text="清筛选"
                        IsVisible="False"
                        FontSize="12" HeightRequest="32" Padding="10,0"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Gray500}"
                        BorderWidth="1" BorderColor="{StaticResource Gray300}"
                        Clicked="OnClearClicked"/>
            </Grid>

            <!-- 搜索：常驻，空格 AND / -排除 / 引号短语，匹配备注 + 那句「下次怎么做」 -->
            <Border Style="{StaticResource FieldBorder}" Padding="12,8">
                <Entry x:Name="SearchEntry"
                       Placeholder="搜备注、片名、目标…（空格分隔 = 同时含，-开头 = 不含）"
                       FontSize="13"
                       TextChanged="OnSearchTextChanged"/>
            </Border>

            <!-- 筛选 chips：全部 / 待同步 / 片 / 目标。只列数据里出现过的，不摆空格子。

                 这里**故意不用 FlexLayout**：.NET 8 的 FlexLayout 遇上 Button 时
                 Wrap 会退化成单行（dotnet/maui#30957，修到 .NET 10 才进主线），
                 表现就是手机上挤成一行、要往右划很久才能看完。
                 改成自己按可用宽度折行（PackChips）：每一行是一个
                 HorizontalStackLayout，行数由内容决定，宽度永远不溢出屏幕。

                 也别引 CommunityToolkit.Maui 的 WrapLayout：项目里只有
                 CommunityToolkit.Mvvm（那是 MVVM 源生成器，没有 UI 控件）。 -->
            <VerticalStackLayout x:Name="ChipRow" Spacing="6"/>


            <Label x:Name="StatusLabel" Text="" FontSize="12" LineBreakMode="WordWrap"/>

            <!-- 按天倒序的分节列表 -->
            <VerticalStackLayout x:Name="Rows" Spacing="6"/>

            <Label x:Name="EmptyLabel" Text=" " IsVisible="False"
                   FontSize="13" TextColor="{StaticResource Gray500}"
                   HorizontalOptions="Center" Margin="0,24"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
