<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalHub.Client.EventListPage"
             Title="事件卡库">

    <!--
        事件卡库：全部历史，按天倒序。想法库的模子 —— 随时能翻、能筛、能看全。
        行交互同款：点行头展开明细；待整理卡展开后可回填重新交给 AI。
    -->
    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="12" MaximumWidthRequest="720">

            <Label
                Text="事件卡库"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"/>
            <Label
                Text="全部历史。点一行展开明细；『待整理』是 AI 没整理成功的兜底卡，攒着可以批量重跑。"
                FontSize="12"
                TextColor="{StaticResource Gray500}"/>

            <!-- 筛选：全部 / 待整理 / 各标签（词表与问题卡共用） -->
            <FlexLayout
                x:Name="FilterChips"
                Wrap="Wrap"
                JustifyContent="Start"
                AlignItems="Start"/>

            <Label
                x:Name="SummaryLabel"
                Text=""
                FontSize="12"
                TextColor="{StaticResource Gray500}"/>

            <CollectionView x:Name="EventList">
                <CollectionView.EmptyView>
                    <Label
                        Text="还没有事件卡。翻车了、听到别人反馈了，就去「事件卡」打几行字。"
                        HorizontalOptions="Center"
                        Margin="0,20"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto,Auto" Padding="0,8">
                            <!-- 行头：点一下展开/收起 -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="{Binding}"/>
                                </Grid.GestureRecognizers>
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding Day}"
                                    FontSize="12"
                                    TextColor="{StaticResource Gray500}"
                                    VerticalOptions="Center"
                                    WidthRequest="44"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="14" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Meta}" FontSize="11" TextColor="{StaticResource Gray500}"/>
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Tag}"
                                    FontSize="12"
                                    TextColor="{StaticResource Gray500}"
                                    VerticalOptions="Center"/>
                                <Label
                                    Grid.Column="3"
                                    Text="{Binding Arrow}"
                                    FontSize="12"
                                    TextColor="{StaticResource Gray500}"
                                    VerticalOptions="Center"/>
                            </Grid>

                            <!-- 明细：默认收起 -->
                            <VerticalStackLayout
                                Grid.Row="1"
                                IsVisible="{Binding IsExpanded}"
                                Spacing="6"
                                Padding="54,8,0,0">
                                <Label Text="{Binding Detail}" FontSize="13" LineBreakMode="WordWrap"/>
                                <Label
                                    Text="{Binding ProblemLine}"
                                    FontSize="12"
                                    TextColor="{StaticResource Primary}"
                                    IsVisible="{Binding HasProblem}"
                                    LineBreakMode="WordWrap"/>
                                <Button
                                    Text="原文填回输入框，重新交给 AI"
                                    FontSize="12"
                                    Padding="10,4"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding IsPending}"
                                    Clicked="OnRefillClicked"/>
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                x:Name="StatusLabel"
                Text=""
                LineBreakMode="WordWrap"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
