<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalHub.Client.IdeaListPage"
             Title="想法库">

    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="12">

            <Label Text="这里是原材料仓库。没有「未处理」计数，也没有清空进度 —— 攒着不发霉才叫库。"
                   FontSize="12" TextColor="{StaticResource Gray500}" LineBreakMode="WordWrap"/>

            <FlexLayout x:Name="FilterChips"
                        Wrap="Wrap" Direction="Row"
                        JustifyContent="Start" AlignItems="Start"/>

            <!-- 范围 + 同步状态占一行：它们都是"这一页在显示什么"的说明，不是筛选条件 -->
            <HorizontalStackLayout Spacing="10">
                <Button x:Name="RangeBtn"
                        Text="范围：最近 100 条"
                        FontSize="12" HeightRequest="30" Padding="12,0" CornerRadius="15"
                        BackgroundColor="#F1EFE8" TextColor="#2C2C2A"
                        Clicked="OnRangeClicked"/>
                <Label x:Name="SyncLabel" Text="" FontSize="11"
                       TextColor="{StaticResource Gray500}"
                       VerticalOptions="Center" LineBreakMode="TailTruncation"/>
            </HorizontalStackLayout>

            <Label x:Name="CountLabel" Text="" FontSize="11"
                   TextColor="{StaticResource Gray500}" LineBreakMode="WordWrap"/>

            <VerticalStackLayout x:Name="IdeaRows" Spacing="8"/>

            <!-- 只有"范围里还有更早的"才出现。不显示"共多少条未读"那种数字 —— 那是积压 -->
            <Button x:Name="MoreBtn" Text="更早的 100 条"
                    IsVisible="False"
                    FontSize="12" HeightRequest="36" Padding="14,0" CornerRadius="10"
                    BackgroundColor="#F1EFE8" TextColor="#2C2C2A"
                    Clicked="OnShowMoreClicked"/>

            <Label x:Name="EmptyLabel" Text="" FontSize="12"
                   TextColor="{StaticResource Gray500}" IsVisible="False"
                   LineBreakMode="WordWrap"/>

            <Label x:Name="StatusLabel" Text="" FontSize="12" LineBreakMode="WordWrap"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
