<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalHub.Client.IdeaListPage"
             Title="想法库">

    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="12">

            <Label Text="这里是原材料仓库。没有「未处理」计数，也没有清空进度 —— 攒着不发霉才叫库。"
                   FontSize="12" TextColor="{StaticResource Gray500}" LineBreakMode="WordWrap"/>

            <FlexLayout x:Name="FilterChips"
                        Wrap="Wrap" Direction="Row"
                        JustifyContent="Start" AlignItems="Start"/>

            <Label x:Name="CountLabel" Text="" FontSize="11"
                   TextColor="{StaticResource Gray500}"/>

            <VerticalStackLayout x:Name="IdeaRows" Spacing="8"/>

            <Label x:Name="EmptyLabel" Text="" FontSize="12"
                   TextColor="{StaticResource Gray500}" IsVisible="False"
                   LineBreakMode="WordWrap"/>

            <Label x:Name="StatusLabel" Text="" FontSize="12" LineBreakMode="WordWrap"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
