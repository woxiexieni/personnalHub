<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalHub.Client.OverviewHubPage"
             Title="概览">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="14">

            <Label
                Text="选择要查看的内容"
                FontSize="12"
                TextColor="{StaticResource Gray500}"/>

            <VerticalStackLayout
                x:Name="ViewRows"
                BindableLayout.ItemTemplate="{StaticResource DirectoryRowTemplate}"/>

            <Label
                Text="以后加：时间资产 · 周复盘 · 月报，都挂在这个目录里。"
                FontSize="11"
                TextColor="{StaticResource Gray500}"
                LineBreakMode="WordWrap"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
