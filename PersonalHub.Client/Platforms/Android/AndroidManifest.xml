<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- usesCleartextTraffic：局域网内服务端是明文 http（h2c），targetSdk 34 默认禁止明文，
	     不放开会导致模拟器/真机直接连不上。仅用于家庭内网调试。 -->
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:usesCleartextTraffic="true"></application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />

	<!-- R13 自动时间片：前台服务采集屏幕亮灭/网络切换/前台应用。
	     FOREGROUND_SERVICE(_SPECIAL_USE)：Android 14+ 要求前台服务声明类型（specialUse），
	     service 节点的类型由 C# [Service] 特性生成（见 SegmentForegroundService）。
	     PACKAGE_USAGE_STATS：signature|appop 级特殊权限，manifest 声明 +
	     用户在「使用情况访问权限」设置里手动开（SegmentServiceHelper 引导）。
	     POST_NOTIFICATIONS：Android 13+ 常驻通知的显示权限；没有它通知不显示但服务照跑，
	     v0 不做运行时申请（省一个授权弹窗），需要看常驻通知时再去应用设置里开。 -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

	<!-- R14.5：读 Wi-Fi SSID（「在家/在公司」的主证据）要求精确定位权限 +
	     定位服务开着 + FGS 带 location 类型（Android 8.1+ 的硬规定）。
	     注意：本 app 并不持续采 GPS 轨迹 —— 权限只是解锁 SSID 读取的门槛；
	     定位本身走 PassiveProvider（别的 app 请求时顺路分发，零额外耗电）。
	     运行时弹窗（「允许访问确切位置？」）由录入页授权卡引导，用户拒绝则无此信号。 -->
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

	<!-- Android 11+ 包可见性（targetSdk 30 起强制）：Launcher.TryOpenAsync 打开 obsidian://
	     之前要先查系统里有没有 app 认这个 scheme，不声明 <queries> 查询结果永远是空，
	     就算装了 Obsidian 也返回 false——表现为「点了成果没反应」（R9 踩坑，2026-11-19）。 -->
	<queries>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="obsidian" />
		</intent>
	</queries>
</manifest>