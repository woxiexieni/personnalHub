<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalHub.Client.ProblemListPage"
             Title="问题卡">

    <!--
        问题卡库：随时可翻。进行中的排前面（欠的债），已解决的归档（战绩）。
        行交互和事件卡列表同款：点行头展开/收起，评估按钮就在展开区里 ——
        周末 30 秒三选一，就是控制环"评估 → 反馈"那一格。
    -->
    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="12" MaximumWidthRequest="720">

            <Label
                Text="问题卡"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"/>
            <Label
                Text="每张卡 = 一个要还的债：判据说清怎么算还完，试法是现在用的招，证据是它真在发作的记录。"
                FontSize="12"
                TextColor="{StaticResource Gray500}"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="建一张问题卡" Clicked="OnAddClicked"/>
                <Button Grid.Column="1"
                        x:Name="ReviewBtn"
                        Text="AI 回看 30 天"
                        Clicked="OnReviewClicked"/>
            </Grid>

            <!-- AI 回看结果：防盲区——你自己意识不到的重复苗头，让 AI 对照历史指出来 -->
            <VerticalStackLayout
                x:Name="ReviewPanel"
                IsVisible="false"
                Spacing="10"
                Padding="14">
                <Label
                    Text="AI 回看：近期重复苗头"
                    FontSize="14"
                    FontAttributes="Bold"/>
                <Label
                    x:Name="ReviewHint"
                    Text="只依据你记的事件卡，一个字不编；看不出来它会说看不出来，不硬凑。"
                    FontSize="11"
                    TextColor="{StaticResource Gray500}"/>
                <VerticalStackLayout x:Name="ReviewRows" Spacing="10"/>
                <Button
                    Text="知道了，收起"
                    FontSize="12"
                    Padding="6,4"
                    Clicked="OnReviewDismissClicked"/>
            </VerticalStackLayout>

            <!-- 分类筛选：与事件卡共用词表；没分类的卡只出现在「全部」里 -->
            <FlexLayout
                x:Name="FilterChips"
                Wrap="Wrap"
                JustifyContent="Start"
                AlignItems="Start"/>

            <!-- 分区头：点一下折叠/展开。进行中默认展开，归档默认收起 -->
            <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnActiveHeaderTapped"/>
                </Grid.GestureRecognizers>
                <Label
                    x:Name="ActiveHeader"
                    Text="进行中"
                    Style="{StaticResource SubHeadline}"
                    VerticalOptions="Center"/>
                <Label
                    x:Name="ActiveArrow"
                    Grid.Column="1"
                    Text="▾"
                    FontSize="12"
                    TextColor="{StaticResource Gray500}"
                    VerticalOptions="Center"/>
            </Grid>

            <CollectionView x:Name="ActiveList">
                <CollectionView.EmptyView>
                    <Label
                        Text="没有进行中的问题卡。翻车了别急着自责——事件卡打进去，AI 会提议立卡。"
                        HorizontalOptions="Center"
                        Margin="0,10"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto,Auto" Padding="0,8">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="{Binding}"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="15" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Meta}" FontSize="12" TextColor="{StaticResource Gray500}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding EvidenceBadge}" FontSize="12" TextColor="{StaticResource Gray500}" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="{Binding Arrow}" FontSize="12" TextColor="{StaticResource Gray500}" VerticalOptions="Center"/>
                            </Grid>
                            <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsExpanded}" Spacing="8" Padding="12,8,0,0">
                                <Label Text="{Binding CriteriaText}" FontSize="13" LineBreakMode="WordWrap"/>
                                <Label Text="{Binding AttemptText}" FontSize="13" LineBreakMode="WordWrap"/>
                                <Label Text="{Binding EvidenceText}" FontSize="12" LineBreakMode="WordWrap" TextColor="{StaticResource Gray500}"/>

                                <!-- 评估三选一：环的"评估 → 反馈"格 -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Button Grid.Column="0" Text="有效，继续" FontSize="12" Padding="6,4" Clicked="OnKeepClicked"/>
                                    <Button Grid.Column="1" Text="没用，换招" FontSize="12" Padding="6,4" Clicked="OnNewAttemptClicked"/>
                                    <Button Grid.Column="2" Text="问题解决了" FontSize="12" Padding="6,4" Clicked="OnSolvedClicked"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Grid.Column="0" Text="放弃这张" FontSize="12" Padding="6,4" Clicked="OnGiveUpClicked"/>
                                    <Button Grid.Column="1" Text="编辑" FontSize="12" Padding="6,4" Clicked="OnEditClicked"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" Margin="0,10"/>

            <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClosedHeaderTapped"/>
                </Grid.GestureRecognizers>
                <Label
                    x:Name="ClosedHeader"
                    Text="已解决 / 放弃"
                    Style="{StaticResource SubHeadline}"
                    VerticalOptions="Center"/>
                <Label
                    x:Name="ClosedArrow"
                    Grid.Column="1"
                    Text="▸"
                    FontSize="12"
                    TextColor="{StaticResource Gray500}"
                    VerticalOptions="Center"/>
            </Grid>
            <CollectionView x:Name="ClosedList" IsVisible="False">
                <CollectionView.EmptyView>
                    <Label Text="还没有关掉的卡。关掉一张 = 一份『我改掉过一个毛病』的书面证据。" HorizontalOptions="Center" Margin="0,10"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,6" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Title}" FontSize="14" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Meta}" FontSize="12" TextColor="{StaticResource Gray500}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding StatusBadge}" FontSize="12" VerticalOptions="Center"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                x:Name="StatusLabel"
                Text=""
                LineBreakMode="WordWrap"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
