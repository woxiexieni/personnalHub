<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalHub.Client.QuarterReviewPage"
             Title="回顾">

    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="12">

            <Label Text="三个数，不用合成一个总分 —— 有总分就会开始优化分数，而不是生活。"
                   FontSize="12" TextColor="{StaticResource Gray500}"/>

            <!-- 投入 / 方向 / 节律 -->
            <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" Padding="14,10">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                        <Label Text="投入" FontSize="11" TextColor="{StaticResource Gray500}"/>
                        <Label x:Name="InvestLabel" Text="—" FontSize="18" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="方向（值得率）" FontSize="11" TextColor="{StaticResource Gray500}"/>
                        <Label x:Name="RateLabel" Text="—" FontSize="18" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="1">
                        <Label Text="节律（活跃周）" FontSize="11" TextColor="{StaticResource Gray500}"/>
                        <Label x:Name="WeeksLabel" Text="—" FontSize="18" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <Label Text="口径：最近四周。手机只缓存 30 天，季度全量统计后续放服务端。"
                   FontSize="11" TextColor="{StaticResource Gray500}"/>

            <!-- 停滞目标：季度回顾真正要做的事 -->
            <Label Text="该砍的砍" Style="{StaticResource SubHeadline}"/>
            <Label Text="14 天没有时间块的目标。复活不是在这里点出来的 —— 记一笔它就会自己回来。"
                   FontSize="11" TextColor="{StaticResource Gray500}"/>
            <VerticalStackLayout x:Name="StalledPanel" Spacing="8"/>
            <Label x:Name="StalledEmpty" Text="没有停滞的目标，这季度还在动。"
                   FontSize="12" TextColor="{StaticResource Gray500}" IsVisible="False"/>

            <!-- 奖励：只让你自己决定，不做自动判定 -->
            <BoxView HeightRequest="1" Color="{StaticResource Gray300}"/>
            <Label Text="想给自己点什么" Style="{StaticResource SubHeadline}"/>
            <Label Text="系统不判断你配不配。这里只是把决定权交给你，勾了就是勾了 —— 不做自动解锁，也不做惩罚。"
                   FontSize="11" TextColor="{StaticResource Gray500}"/>
            <VerticalStackLayout x:Name="RewardPanel" Spacing="8"/>

            <Label x:Name="StatusLabel" Text="" FontSize="12" LineBreakMode="WordWrap"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
