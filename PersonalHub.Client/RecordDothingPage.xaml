<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalHub.Client.RecordDothingPage"
             Title="事件卡">

    <!--
        R7 改版：8 个必填字段的表单废掉了（没人填 = 没人复盘）。
        新流程：想到什么打什么 → AI 拆成事件卡草稿 → 逐张确认保存。
        老的 ThingRecord 表原样不动，只是录入路径换了。
    -->
    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="12">

            <!--
                照想法录入的模子（R6→R9.1）：没有大标题、没有小节标题，就一行提示 + 一个大框。
                R7 的"事件卡"Headline 和"想到什么打什么"SubHeadline 都删了 ——
                录入页唯一的敌人是"还没写完就放弃了"，标题撑不起这个场面。
            -->
            <Label Text="想到什么打什么。乱序、带情绪、骂街都行，几件事混在一起没关系，AI 会拆开。"
                   FontSize="12" TextColor="{StaticResource Gray500}" LineBreakMode="WordWrap"/>
            <!--
                输入框照 IdeaEntryPage 的模子：固定最小高度、不用 AutoSize。
                AutoSize="TextChanges" 每敲一个字都让整页重新量布局，Windows 上光标
                容易滚出视野、页面跟着跳 —— "输入难受"的主因就是它。
                内容超了在框内滚动，和想法录入同一个手感。
            -->
            <Border Style="{StaticResource FieldBorder}">
                <Editor
                    x:Name="RawInput"
                    Style="{StaticResource FieldEditor}"
                    Placeholder="例：前天拍照对姐姐没礼貌，刚才跟zqq打电话又杠起来，说了不少蠢话……"
                    MinimumHeightRequest="150"
                    FontSize="15"
                    MaxLength="2000"/>
            </Border>

            <!-- 这些事大概什么时候发生的（一张批共用）：默认"现在"，折叠成一行小字，点开才出现选择器。
                 想法录入没有时间行照样好使 —— 大多数时候记的就是刚才的事，常驻两颗选择器只是表单感。 -->
            <VerticalStackLayout Spacing="8">
                <Label x:Name="TimeFoldLabel"
                       Text="▸ 大概时间：现在（点开改）"
                       FontSize="12"
                       TextColor="{StaticResource Gray500}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTimeFoldTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Grid x:Name="TimePickers" ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="False">
                    <DatePicker x:Name="EventDatePicker" Grid.Column="0" Format="yyyy-MM-dd" DateSelected="OnEventTimeChanged"/>
                    <TimePicker x:Name="EventTimePicker" Grid.Column="1" Format="HH:mm"/>
                </Grid>
            </VerticalStackLayout>

            <Button
                x:Name="ExtractBtn"
                Text="交给 AI 整理"
                Clicked="OnExtractClicked"
                HeightRequest="46"
                HorizontalOptions="Fill"/>

            <!-- AI 挂了 / 没网的时候：原文先落本地，不丢 -->
            <Button
                x:Name="SaveRawBtn"
                Text="AI 整理不了，先存原文（待整理）"
                Clicked="OnSaveRawClicked"
                HorizontalOptions="Fill"
                IsVisible="False"/>

            <Label
                x:Name="StatusLabel"
                Text=""
                LineBreakMode="WordWrap"/>

            <!-- ============ 2. AI 草稿卡（逐张确认，代码动态生成） ============ -->
            <VerticalStackLayout x:Name="DraftCards" Spacing="14"/>

            <!-- ============ 3. 今日事件卡 ============ -->
            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" Margin="0,10"/>
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Grid.Column="0"
                    Text="今日事件卡"
                    Style="{StaticResource SubHeadline}"
                    VerticalOptions="Center"/>
                <Button
                    Grid.Column="1"
                    Text="全部事件卡 ›"
                    FontSize="12"
                    Padding="8,2"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Clicked="OnOpenEventListClicked"/>
            </Grid>
            <CollectionView x:Name="TodayReflectList" HeightRequest="300">
                <CollectionView.EmptyView>
                    <Label Text="今天还没有事件卡" HorizontalOptions="Center" Margin="0,20"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto,Auto" Padding="0,8">
                            <!-- 行头：点一下 = 展开/收起明细 -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThingTapped" CommandParameter="{Binding}"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="14" LineBreakMode="TailTruncation"/>
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding EventTime}" FontSize="12" TextColor="{StaticResource Gray500}"/>
                                        <Label Text="{Binding SyncText}" FontSize="12" TextColor="{Binding SyncColor}"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Tag}"
                                    FontSize="14"
                                    VerticalOptions="Center"/>
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Arrow}"
                                    FontSize="12"
                                    TextColor="{StaticResource Gray500}"
                                    VerticalOptions="Center"/>
                            </Grid>
                            <!-- 明细：默认收起，点行头展开 -->
                            <VerticalStackLayout
                                Grid.Row="1"
                                IsVisible="{Binding IsExpanded}"
                                Spacing="4"
                                Padding="12,8,0,0">
                                <Label Text="{Binding Detail}" FontSize="13" LineBreakMode="WordWrap"/>
                                <Button
                                    Text="原文填回输入框，重新交给 AI"
                                    FontSize="12"
                                    Padding="10,4"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding IsPending}"
                                    Clicked="OnRefillRawClicked"/>
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
