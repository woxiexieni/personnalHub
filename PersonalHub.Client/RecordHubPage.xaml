<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalHub.Client.RecordHubPage"
             Title="记录">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="14">

            <!-- ============ 提示 + 同步状态 ============
                 大标题没有再写一遍"记录"：导航栏已经是这个名字了，
                 同屏出现两次同名字最容易被当成没加载完。 -->
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Text="选择要记录的内容"
                    FontSize="12"
                    TextColor="{StaticResource Gray500}"
                    VerticalOptions="Center"/>
                <Label
                    x:Name="SyncLabel"
                    Grid.Column="1"
                    Text=""
                    FontSize="11"
                    TextColor="{StaticResource Gray500}"
                    VerticalOptions="Center"/>
            </Grid>

            <!-- ============ 类型目录（项由 RecordCatalog 生成，行模板与概览页共用） ============ -->
            <VerticalStackLayout
                x:Name="TypeRows"
                BindableLayout.ItemTemplate="{StaticResource DirectoryRowTemplate}"/>

            <!-- ============ 说明：这段是给"三个月后的自己"看的 ============ -->
            <Label
                Text="以后要加新类型（习惯、体重、阅读…），都挂在这个目录里，底部导航不用改。"
                FontSize="11"
                TextColor="{StaticResource Gray500}"
                LineBreakMode="WordWrap"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
