@page
@model IndexModel
@using personalHub.Server.Data
@{
    ViewData["Title"] = "概览";
    var month = Model.Month;
}

@if (Model.BackupWarning is string warn)
{
    <div class="err">@warn · <a href="/backup">去备份页看看 →</a></div>
}

<div class="card">
    <div class="card-head">
        <h2>今日 · @Fmt.ShortDate(Model.Today.From)</h2>
        <a class="btn sm" href="/records/edit">补录一笔</a>
    </div>
    <div class="kpis">
        <div class="kpi">
            <div class="label">支出</div>
            <div class="num expense">@Fmt.Yuan(Model.Today.ExpenseCents)</div>
            <div class="sub">@Model.Today.ExpenseCount 笔</div>
        </div>
        <div class="kpi">
            <div class="label">收入</div>
            <div class="num income">@Fmt.Yuan(Model.Today.IncomeCents)</div>
            <div class="sub">今天收到的</div>
        </div>
        <div class="kpi">
            <div class="label">结余</div>
            <div class="num balance">@Fmt.Yuan(Model.Today.IncomeCents - Model.Today.ExpenseCents)</div>
            <div class="sub">收入 − 支出</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h2>本月 · @Fmt.ShortDate(month.Range.From) 起</h2>
        <span class="hint">
            @if (month.HasPrev)
            {
                <span class="@(month.DeltaRatio >= 0 ? "up" : "down")">较上月同期 @Fmt.Delta(month.DeltaRatio)</span>
            }
            else
            {
                <span class="flat">较上月同期 —（无数据）</span>
            }
        </span>
    </div>
    <div class="kpis">
        <div class="kpi">
            <div class="label">支出</div>
            <div class="num expense">@Fmt.Yuan(month.ExpenseCents)</div>
            <div class="sub">@month.ExpenseCount 笔 · 日均 @Fmt.Yuan(month.DailyAvgCents)</div>
        </div>
        <div class="kpi">
            <div class="label">收入</div>
            <div class="num income">@Fmt.Yuan(month.IncomeCents)</div>
            <div class="sub">本月累计</div>
        </div>
        <div class="kpi">
            <div class="label">结余</div>
            <div class="num balance">@Fmt.Yuan(month.IncomeCents - month.ExpenseCents)</div>
            <div class="sub">上期支出 @Fmt.Yuan(month.PrevExpenseCents)</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h2>本月支出结构</h2>
        <span class="hint">按分类，占比分母是本月全部支出</span>
    </div>

    @if (month.Categories.Count == 0)
    {
        <div class="empty">本月还没有支出记录。<a href="/records/edit">补录一笔 →</a></div>
    }
    else
    {
        <div class="rows">
            @foreach (var c in month.Categories)
            {
                <div class="row">
                    <div class="name" title="@c.Name">@c.Name</div>
                    <div class="bar"><i style="width:@(Fmt.Pct(c.Cents / (double)Math.Max(1, month.ExpenseCents)))%"></i></div>
                    <div class="amt">
                        @Fmt.Yuan(c.Cents)
                        @if (c.HasPrev)
                        {
                            <span class="hint @(c.DeltaRatio >= 0 ? "up" : "down")">@Fmt.Delta(c.DeltaRatio)</span>
                        }
                    </div>
                    <div class="ratio">@Fmt.Pct(c.Cents / (double)Math.Max(1, month.ExpenseCents))%</div>
                </div>
            }
        </div>
    }
</div>

<div class="card">
    <div class="card-head">
        <h2>时间 · 今天</h2>
        <a class="btn sm" href="/blocks">时间块 →</a>
    </div>
    <div class="kpis">
        <div class="kpi">
            <div class="label">已记录</div>
            <div class="num balance">@Pieces.Minutes(Model.TodayTime.RecordedMinutes)</div>
            <div class="sub">@Model.TodayTime.Count 条</div>
        </div>
        <div class="kpi">
            <div class="label">未记录</div>
            <div class="num expense">@Pieces.Minutes(Model.TodayTime.UnrecordedMinutes)</div>
            <div class="sub">已过去 @Pieces.Minutes(Model.TodayTime.ElapsedMinutes)</div>
        </div>
        <div class="kpi">
            <div class="label">本周</div>
            <div class="num income">@Pieces.Minutes(Model.WeekTime.RecordedMinutes)</div>
            <div class="sub">覆盖率 @Model.WeekTime.CoverPct%（本周已过去）</div>
        </div>
    </div>
    <div class="hint" style="margin-top:12px">
        未记录这一栏是整页最有信息量的数字：人不会去记的，恰恰是浪费时间的那几小时。
    </div>
</div>

@if (Model.TodayTime.Pieces.Count > 0)
{
    <div class="card">
        <div class="card-head">
            <h2>今天的时间去哪了</h2>
            <span class="hint">按事情片，占比分母是今天已记录时间</span>
        </div>
        <div class="rows">
            @foreach (var p in Model.TodayTime.Pieces.Take(6).Where(x => x.Minutes > 0))
            {
                <div class="row">
                    <div class="name" title="@Pieces.Name(p.PieceCode)">@Pieces.Name(p.PieceCode)</div>
                    <div class="bar">
                        <i style="width:@(Model.TodayTime.RecordedMinutes > 0 ? Fmt.Pct(p.Minutes / (double)Model.TodayTime.RecordedMinutes) : "0")%"></i>
                    </div>
                    <div class="amt">@Pieces.Minutes(p.Minutes)</div>
                    <div class="ratio">@(Model.TodayTime.RecordedMinutes > 0 ? Fmt.Pct(p.Minutes / (double)Model.TodayTime.RecordedMinutes) : "0")%</div>
                </div>
            }
        </div>
    </div>
}

@if (month.PayMethods.Count > 0)
{
    <div class="card">
        <div class="card-head">
            <h2>支付方式</h2>
            <span class="hint">老数据已按「微信/支付宝/现金/银行卡」归一化</span>
        </div>
        <div class="rows">
            @foreach (var p in month.PayMethods)
            {
                <div class="row">
                    <div class="name" title="@p.Name">@p.Name</div>
                    <div class="bar pay"><i style="width:@(Fmt.Pct(p.Cents / (double)Math.Max(1, month.ExpenseCents)))%"></i></div>
                    <div class="amt">@Fmt.Yuan(p.Cents)</div>
                    <div class="ratio">@Fmt.Pct(p.Cents / (double)Math.Max(1, month.ExpenseCents))%</div>
                </div>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-head">
        <h2>最近记录</h2>
        <a class="btn sm" href="/records">全部账单 →</a>
    </div>

    @if (Model.Recent.Count == 0)
    {
        <div class="empty">还没有任何记录。</div>
    }
    else
    {
        <table class="grid">
            <thead>
            <tr>
                <th>时间</th>
                <th>类型</th>
                <th>分类</th>
                <th>支付</th>
                <th>备注</th>
                <th class="num">金额</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Recent.Take(5))
            {
                <tr>
                    <td>@Fmt.DateTimeText(r.SpentAt)</td>
                    <td><span class="tag @(r.Direction == 1 ? "income" : "")">@Fmt.Direction(r.Direction)</span></td>
                    <td>@Model.CategoryName(r.CategoryId)</td>
                    <td>@r.PayMethod</td>
                    <td>@r.Note</td>
                    <td class="num">@Fmt.Amount(r.Amount)</td>
                    <td><a class="btn sm" href="/records/edit?id=@r.Id">编辑</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
