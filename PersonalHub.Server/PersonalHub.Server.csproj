<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo> <!-- 加上这一行 -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  
    <ItemGroup>
    <!-- 1. 引入工具包 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- 账单落盘：与服务端「换 SQLite」目标一致。自带 SQLitePCLRaw.bundle_green，Windows x64 直接可用。 -->
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
  </ItemGroup>

  <ItemGroup>
    <!-- 2. 指定 Proto 文件路径 -->
    <!-- GrpcServices="Server" 表示生成服务端基类；如果是客户端则填 "Client" -->
    <Protobuf Include="..\protos\personalHub.proto" GrpcServices="Server" Link="protos\personalHub.proto" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\" />
    <Folder Include="Models\" />
  </ItemGroup>

</Project>
